/* 首页样式 */
.container { padding-bottom: 40rpx; }

/* Header */
.header {
  background: linear-gradient(160deg, #1a1a2e 0%, #16213e 40%, #0f3460 70%, #1a1a2e 100%);
  padding: 80rpx 40rpx 48rpx;
  text-align: center;
  position: relative;
}
.header-logo { font-size: 60rpx; font-weight: 800; color: #fff; letter-spacing: 12rpx; }
.logo-gold {
  background: linear-gradient(135deg, #c9a96e, #e8d5aa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.header-sub { margin-top: 12rpx; font-size: 22rpx; color: rgba(255,255,255,0.4); letter-spacing: 6rpx; }
.header-divider { width: 120rpx; height: 2rpx; background: linear-gradient(90deg, transparent, #c9a96e, transparent); margin: 24rpx auto 0; }

/* Quick Entries */
.quick-entries { display: flex; padding: 32rpx 24rpx; gap: 16rpx; }
.entry-item {
  flex: 1; background: #fff; border-radius: 20rpx; padding: 32rpx 16rpx;
  text-align: center; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}
.entry-item:active { transform: scale(0.97); }
.entry-icon { font-size: 48rpx; margin-bottom: 12rpx; }
.entry-text { font-size: 26rpx; font-weight: 600; color: #1a1a2e; margin-bottom: 8rpx; }
.entry-count { font-size: 20rpx; color: #c9a96e; }

/* Section */
.section { padding: 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; padding: 0 8rpx; }
.section-title { font-size: 30rpx; font-weight: 700; color: #1a1a2e; letter-spacing: 4rpx; }
.section-more { font-size: 24rpx; color: #c9a96e; }

/* Hot Products */
.hot-scroll { white-space: nowrap; }
.hot-list { display: inline-flex; gap: 20rpx; padding: 8rpx 4rpx 16rpx; }
.hot-card { width: 240rpx; display: inline-block; }
.hot-img {
  width: 240rpx; height: 300rpx; border-radius: 16rpx; background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.hot-name {
  text-align: center; font-size: 24rpx; color: #1a1a2e; margin-top: 12rpx;
  font-weight: 600; letter-spacing: 4rpx;
}

/* Brand */
.brand-card { padding: 32rpx; }
.brand-text { font-size: 26rpx; color: #666; line-height: 2; text-indent: 2em; }
.brand-features {
  display: flex; justify-content: space-around; margin-top: 32rpx;
  padding-top: 24rpx; border-top: 1rpx dashed rgba(201,169,110,0.25);
}
.feature-item { text-align: center; }
.feature-num { font-size: 36rpx; font-weight: 800; color: #c9a96e; }
.feature-label { font-size: 22rpx; color: #999; margin-top: 8rpx; }
.feature-divider { width: 1rpx; background: rgba(0,0,0,0.08); }

/* Contact */
.contact-section { margin-bottom: 40rpx; }
.contact-card { padding: 24rpx 32rpx; }
.contact-row { display: flex; align-items: center; gap: 16rpx; }
.contact-label { font-size: 26rpx; color: #999; flex-shrink: 0; }
.contact-value { font-size: 26rpx; color: #1a1a2e; font-weight: 600; flex: 1; }
.contact-btn {
  padding: 8rpx 28rpx; border: 1rpx solid #c9a96e; border-radius: 30rpx;
  font-size: 22rpx; color: #c9a96e;
}
