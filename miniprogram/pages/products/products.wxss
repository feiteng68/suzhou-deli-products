/* 产品列表页样式 */
.container { padding-bottom: 40rpx; }

/* 搜索区 */
.search-section {
  position: sticky; top: 0; z-index: 100;
  background: rgba(240,236,230,0.95);
  backdrop-filter: blur(16px);
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(201,169,110,0.12);
}
.search-title { text-align: center; font-size: 20rpx; color: #aaa; margin-bottom: 16rpx; letter-spacing: 4rpx; }
.search-bar { position: relative; max-width: 640rpx; margin: 0 auto 20rpx; }
.search-input {
  width: 100%; padding: 20rpx 70rpx 20rpx 32rpx;
  border: 2rpx solid rgba(201,169,110,0.25); border-radius: 48rpx;
  font-size: 28rpx; background: rgba(255,255,255,0.8); color: #2c2c2c;
}
.search-clear {
  position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%);
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  color: #bbb; font-size: 32rpx;
}

/* 字母筛选 */
.alpha-scroll { white-space: nowrap; }
.alpha-bar { display: inline-flex; gap: 12rpx; padding: 4rpx; }
.alpha-btn {
  min-width: 56rpx; height: 56rpx; padding: 0 16rpx;
  border: 2rpx solid rgba(201,169,110,0.2); border-radius: 14rpx;
  background: rgba(255,255,255,0.6); color: #888;
  font-size: 24rpx; font-weight: 600;
  display: inline-flex; align-items: center; justify-content: center;
}
.alpha-btn.active {
  background: #c9a96e; border-color: #c9a96e; color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(201,169,110,0.4);
}
.alpha-btn.all-btn {
  padding: 0 24rpx; background: linear-gradient(135deg, #1a1a2e, #0f3460);
  border-color: transparent; color: rgba(255,255,255,0.8);
}
.alpha-btn.all-btn.active {
  background: linear-gradient(135deg, #a88840, #c9a96e); color: #fff;
}

/* 统计 */
.result-count { text-align: center; font-size: 22rpx; color: #aaa; margin-top: 12rpx; }
.count-num { color: #c9a96e; font-weight: 600; }

/* 产品区 */
.products-wrap { padding: 16rpx 20rpx; }

/* 分组标题 */
.group-title {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 8rpx 16rpx;
}
.letter-badge {
  width: 64rpx; height: 64rpx;
  background: linear-gradient(145deg, #1a1a2e, #0f3460);
  color: #c9a96e; font-size: 36rpx; font-weight: 800;
  border-radius: 16rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(26,26,46,0.25);
}
.group-name { font-size: 22rpx; color: #bbb; letter-spacing: 4rpx; }

/* 产品网格 */
.product-grid { display: flex; flex-wrap: wrap; gap: 20rpx; justify-content: space-between; }
.product-card {
  width: calc(50% - 10rpx); background: #fff; border-radius: 20rpx;
  overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 8rpx;
}
.product-card:active { transform: scale(0.98); }

/* 图片 */
.card-img-wrap {
  width: 100%; aspect-ratio: 4/5; background: #fff; overflow: hidden;
}
.card-img { width: 100%; height: 100%; }

/* 卡片内容 */
.card-body { padding: 20rpx 20rpx 24rpx; }
.card-name {
  font-size: 26rpx; font-weight: 700; color: #1a1a2e;
  margin-bottom: 12rpx; letter-spacing: 4rpx;
}

/* 规格 */
.card-spec { border-top: 1rpx dashed rgba(201,169,110,0.2); padding-top: 10rpx; }
.spec-row { display: flex; align-items: flex-start; gap: 10rpx; margin-bottom: 6rpx; }
.spec-type {
  flex-shrink: 0; width: 72rpx; font-size: 18rpx; color: #9a7030;
  font-weight: 600; text-align: left;
}
.spec-sizes { flex: 1; display: flex; flex-wrap: wrap; gap: 6rpx; }
.spec-size-item {
  background: #f5f2ed; border-radius: 6rpx; padding: 2rpx 10rpx;
  font-size: 18rpx; color: #888; white-space: nowrap;
}
.spec-row-album { margin-top: 10rpx; padding-top: 10rpx; border-top: 1rpx dashed rgba(201,169,110,0.2); }
.spec-type-album { width: auto; min-width: 72rpx; color: #6a5020; font-size: 18rpx; }

/* 空状态 */
.empty-state { text-align: center; padding: 120rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }
.empty-hint { font-size: 24rpx; color: #ccc; margin-top: 12rpx; }
