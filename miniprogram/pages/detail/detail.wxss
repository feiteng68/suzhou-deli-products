.container { padding-bottom: 60rpx; }

/* 产品图片 */
.detail-img-wrap { width: 100%; background: #fff; }
.detail-img { width: 100%; }

/* 内容区 */
.detail-content { padding: 32rpx; }

/* 分段标题 */
.detail-section { margin-bottom: 40rpx; }
.section-title {
  display: flex; align-items: center; gap: 16rpx;
  font-size: 24rpx; color: #c9a96e; font-weight: 600;
  letter-spacing: 6rpx; margin-bottom: 20rpx;
}
.section-line { flex: 1; height: 1rpx; background: linear-gradient(90deg, rgba(201,169,110,0.25), transparent); }

/* 规格表 */
.spec-table { width: 100%; }
.spec-row { display: flex; align-items: flex-start; padding: 12rpx 0; }
.spec-col-type {
  width: 120rpx; flex-shrink: 0;
  font-size: 26rpx; font-weight: 700; color: #a88840;
  padding-right: 20rpx;
}
.spec-col-sizes { flex: 1; display: flex; flex-wrap: wrap; gap: 12rpx; }
.spec-chip {
  background: rgba(240,236,230,0.6); border: 1rpx solid rgba(201,169,110,0.12);
  border-radius: 10rpx; padding: 6rpx 20rpx;
  font-size: 24rpx; color: #555; white-space: nowrap;
}
.spec-divider-row {
  height: 1rpx; background: rgba(201,169,110,0.3);
  margin: 8rpx 0;
}
.spec-album .spec-col-type { color: #6a5020; font-size: 24rpx; width: auto; min-width: 120rpx; }

/* 简介 */
.intro-text { font-size: 28rpx; color: #666; line-height: 2.2; text-indent: 2em; }

/* 底部操作 */
.bottom-actions { margin-top: 48rpx; padding: 0 20rpx; }
.action-btn {
  padding: 28rpx; border-radius: 48rpx; text-align: center;
  font-size: 30rpx; font-weight: 600; letter-spacing: 6rpx;
}
.action-primary {
  background: linear-gradient(135deg, #c9a96e, #a88840); color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(201,169,110,0.4);
}
.action-primary:active { transform: scale(0.97); opacity: 0.9; }

/* 加载 / 空状态 */
.loading-state, .empty-state { text-align: center; padding: 200rpx 40rpx; }
.loading-text { font-size: 28rpx; color: #aaa; }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }
.empty-text { font-size: 28rpx; color: #aaa; }
